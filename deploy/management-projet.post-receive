#!/usr/bin/env bash
set -Eeuo pipefail
trap 'printf "Deployment failed at line %s; inspect live services. Git receipt is not deployment success.\n" "$LINENO" >&2' ERR
# Operator template: configure private sourceWorkTree and healthURL in the bare repository.
target="$(git config --get chatAI.sourceWorkTree)"
repo="$(git rev-parse --absolute-git-dir)"
health_url="$(git config --get chatAI.healthURL)"
backup_dir="$(git config --get chatAI.backupDir)"
[[ "$target" == /* && -d "$target" && "$health_url" == https://* ]] || exit 1
[[ "$backup_dir" == /* && "$backup_dir" != "$target" && "$backup_dir" != "$target/"* ]] || exit 1
exec 9>"$repo/deploy.lock"
flock 9
while read -r oldrev newrev ref; do
  [[ "$ref" == refs/heads/main ]] || continue
  [[ "$newrev" == "$(git --git-dir="$repo" rev-parse refs/heads/main)" ]] || continue
  git --work-tree="$target" --git-dir="$repo" checkout -f main
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
  cd "$target"
  compose=(docker compose --project-directory "$target" -f "$target/docker-compose.yml")
  "${compose[@]}" config --quiet
  docker exec nginx nginx -t
  install -d -m 700 "$backup_dir"
  attempt_id="${newrev:0:12}-$(date -u +%Y%m%dT%H%M%S%NZ)"
  images="$backup_dir/rollback-$attempt_id.images.tsv"
  (umask 077; : > "$images")
  # oldrev is a received Git revision, not proof of the currently deployed image.
  for service in web; do
    running="$("${compose[@]}" ps -q "$service")"
    if [[ -n "$running" ]]; then
      image="$(docker inspect --format '{{.Image}}' "$running")"
      printf '%s\t%s\t%s\n' "$service" "$running" "$image" >> "$images"
      docker image tag "$image" "management-projet-frontend-rollback:$service-$attempt_id"
    fi
  done
  "${compose[@]}" build web
  "${compose[@]}" up --no-deps --no-build --wait --wait-timeout 180 web
  # Preserve the shared reverse proxy; reload it gracefully after replacing frontend.
  docker exec nginx nginx -t
  docker exec nginx nginx -s reload
  curl --fail --silent --show-error --output /dev/null "$health_url"
  printf 'Management Projet frontend deployment verified: %s\n' "$newrev"
done
